#!/usr/bin/env bash

# Check if any argument is provided
if [ $# -eq 0 ]; then
    echo "Error: No script provided"
    exit 1
fi

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

# Check for the repository-local Bun from either the source package or node_modules.
if [ -x "$SCRIPT_DIR/../.bun/bin/bun" ]; then
    exec "$SCRIPT_DIR/../.bun/bin/bun" "$@"
elif [ -x "$SCRIPT_DIR/../../.bun/bin/bun" ]; then
    exec "$SCRIPT_DIR/../../.bun/bin/bun" "$@"
# Check for bun in PATH
elif command -v bun >/dev/null 2>&1; then
    exec bun "$@"
# Check for node in PATH
elif command -v node >/dev/null 2>&1; then
    exec node "$@"
else
    echo "Error: Neither bun nor node found in PATH"
    exit 1
fi
